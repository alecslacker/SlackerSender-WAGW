# Server
PORT=8080
GIN_MODE=release
APP_NAME=SlackerSender
# URL publik (tanpa garis miring akhir). WAJIB diisi di production, mis. https://wasender.slackercode.us
# — dipakai tautan pada pesan ke pelanggan, invoice, redirect OAuth, webhook pembayaran, dan origin CORS.
APP_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://user:password@localhost:5432/wagataway?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=24h

# Alamat dengar (opsional). Kosong = semua antarmuka.
# Di belakang nginx/aaPanel isi 127.0.0.1 agar port aplikasi tidak terbuka publik.
LISTEN_HOST=

# WhatsApp
WA_SESSIONS_DIR=./wa-sessions

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SlackerSender <noreply@slackersender.com>

# AI
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# Backend AI bawaan (9router milik Duta Corpora). Ganti bila pindah server.
AI_DEFAULT_BASE_URL=https://9router.dutacorpora.co.id/v1
AI_DEFAULT_MODEL=ag/gemini-3.8-flash-low
# Gateway pembayaran Clipku Pay (opsional; kosong = bawaan https://m.clipku.com)
# CLIPKUPAY_BASE_URL=https://m.clipku.com

# Payment Gateway
PAYMENT_GATEWAY_KEY=xxx
PAYMENT_GATEWAY_SECRET=xxx

# Telegram Notifications
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx
